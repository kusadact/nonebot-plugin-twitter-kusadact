# Fill route values in the deployment environment. Both features default to off.
twitter_template_enabled=false
twitter_translation_enabled=false
twitter_translation_primary={"url":"https://generativelanguage.googleapis.com/v1beta","key":"REPLACE_AT_DEPLOYMENT","model":"YOUR_GEMINI_MODEL"}
twitter_translation_fallback={"url":"https://api.deepseek.com/v1","key":"REPLACE_AT_DEPLOYMENT","model":"YOUR_DEEPSEEK_MODEL"}
twitter_translation_timeout=60
twitter_translation_max_chars=30000
twitter_render_width=640
twitter_render_max_height=8000
